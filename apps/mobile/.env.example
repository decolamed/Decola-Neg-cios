# Chaves PÚBLICAS do Supabase — as únicas que o app cliente pode conhecer.
# A anon key é protegida por RLS; sem um JWT válido ela não lê nada.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# ATENÇÃO (Seções 6.4 e 9.1): a chave da API do Asaas e a service_role key do
# Supabase NUNCA entram aqui. Elas vivem apenas como secrets de Edge Function
# no backend. Qualquer variável com prefixo EXPO_PUBLIC_ é embutida no binário
# do app e deve ser tratada como pública.

# Onde o site público está publicado. Entra nos links da loja virtual que o
# lojista compartilha com os clientes dele. Sem esta variável vale a produção
# (https://sitedecolanegocios.vercel.app); defina-a para apontar a um ambiente de
# teste.
EXPO_PUBLIC_URL_SITE=https://sitedecolanegocios.vercel.app
