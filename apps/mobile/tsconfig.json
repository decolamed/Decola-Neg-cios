{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@decola/pix": [
        "../../packages/pix/src/index.ts"
      ],
      "@decola/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@decola/types": [
        "../../packages/types/src/database.ts"
      ]
    },
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/pix/src/**/*.ts",
    "../../packages/theme/src/**/*.ts",
    "../../packages/types/src/**/*.ts"
  ]
}
