{
  "expo": {
    "name": "Decola Negócios",
    "slug": "decola-negocios",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "decolanegocios",
    "userInterfaceStyle": "light",
    "icon": "./assets/icone.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F2B532"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "br.com.decolanegocios.app" },
    "android": {
      "package": "br.com.decolanegocios.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icone-adaptativo.png",
        "backgroundColor": "#F2B532"
      }
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": false }
  }
}
