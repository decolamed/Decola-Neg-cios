{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@decola/theme": ["../../packages/theme/src/index.ts"],
      "@decola/types": ["../../packages/types/src/database.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/theme/src/**/*.ts",
    "../../packages/types/src/**/*.ts"
  ]
}
